# Copy to .env for local work. Plain KEY=value; optional matching quotes, no
# interpolation. Process environment variables take precedence. Never commit
# credentials. Production uses /etc/status-dunamismax/web.env for the web pool
# and /etc/status-dunamismax/collector.env for the collector (see docs/production.md).
APP_ENV=local

# Leave DB_NAME blank for a database-free preview: pages show "no status data
# yet" and `make collect` prints one snapshot as JSON instead of storing it.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Repository checkouts the collector inspects; the operator page shows these paths.
STATUS_REPO_ROOT=/home/sawyer/github

# Web: minutes before the latest snapshot is shown as stale.
STATUS_STALE_AFTER_MINUTES=15
# Web: enables /operator with `Authorization: Bearer <token>` (32+ characters).
# STATUS_OPERATOR_TOKEN=

# Collector: check-row retention and public-safe webhook alerts.
STATUS_RETENTION_DAYS=30
# STATUS_ALERT_WEBHOOK_URL=https://example.com/status-alerts
STATUS_ALERT_REPEAT_AFTER_MINUTES=60
STATUS_ALERT_MAX_NOTIFICATIONS_PER_RUN=5
