{
  "extends": "$app/tsconfig",
  "include": [
    "src",
    "tests",
    "scripts",
    "drizzle.config.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "dist",
    "build",
    "node_modules"
  ],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}
