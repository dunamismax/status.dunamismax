{
  "name": "status-dunamismax",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "check": "astro check && tsc --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "build": "astro build && tsc -p tsconfig.cli.json",
    "test": "tsc -p tsconfig.cli.json && node --test build/tests/*.test.js",
    "start": "node dist/server/entry.mjs",
    "collect": "node build/src/collector/cli.js collect",
    "record-deployment": "node build/src/collector/cli.js record-deployment"
  },
  "dependencies": {
    "astro": "7.4.2",
    "@astrojs/node": "11.1.9",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1"
  }
}
