{
  "name": "status-dunamismax",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.cli.json --noEmit",
    "build": "vite build && tsc -p tsconfig.cli.json",
    "test": "npm run build && node --test build/tests/*.test.js",
    "start": "node dist/index.js",
    "collect": "node build/src/collector/cli.js collect",
    "record-deployment": "node build/src/collector/cli.js record-deployment",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && drizzle-kit generate --name drift | tee /dev/stderr | grep -q 'No schema changes'",
    "db:migrate": "node build/src/db/migrate.js"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.2",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.11",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.7"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
