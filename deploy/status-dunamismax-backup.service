[Unit]
Description=Back up Dunamis Status PostgreSQL, retained MySQL and configuration
After=postgresql.service mysql.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/status-dunamismax-backup
UMask=0077
Nice=10
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/status-dunamismax /run/astro-deploy /var/tmp /root
