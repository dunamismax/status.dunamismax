# Runtime configuration for status-dunamismax.service.
# Copy to /etc/status-dunamismax/status.env on the host and adjust only when
# the local bind address or log filter needs to change.

STATUS_BIND_ADDR=127.0.0.1:8095
STATUS_LOG=status_web=info,tower_http=info
STATUS_REPO_ROOT=/home/sawyer/github

# Optional. Enables authenticated operator-only routes such as /operator.
# Leave unset to keep operator routes disabled.
# STATUS_OPERATOR_TOKEN=change-me

# Optional. When set, the app runs migrations at startup, /readyz checks the
# database, and STATUS_COLLECT_ONCE can persist status snapshots.
# STATUS_DATABASE_URL=postgres://status-dunamismax@localhost/status_dunamismax

# Optional one-shot collector mode for a systemd timer or manual history run.
# STATUS_COLLECT_ONCE=true
STATUS_RETENTION_DAYS=30

# Optional alert notifications. Alerts are evaluated during
# STATUS_COLLECT_ONCE runs and require STATUS_DATABASE_URL so duplicate
# suppression is durable. Payloads contain public-safe status summaries only.
# STATUS_ALERT_WEBHOOK_URL=https://example.com/status-alerts
STATUS_ALERT_REPEAT_AFTER_MINUTES=60
STATUS_ALERT_MAX_NOTIFICATIONS_PER_RUN=5

# Optional explicit deployment event recording mode. Toolworks can set these
# transiently while sourcing this env file so the database URL is not passed on
# the process command line.
# STATUS_RECORD_DEPLOYMENT=true
# STATUS_DEPLOYMENT_SERVICE_ID=status-dunamismax
# STATUS_DEPLOYMENT_REPO_NAME=status.dunamismax
# STATUS_DEPLOYMENT_COMMIT_SHA=
# STATUS_DEPLOYMENT_ENVIRONMENT=production
# STATUS_DEPLOYMENT_DEPLOYED_AT=2026-05-18T12:00:00Z
# STATUS_DEPLOYMENT_PUBLIC_SUMMARY=status.dunamismax deployed to production
