# Runtime configuration for status-dunamismax.service.
# Copy to /etc/status-dunamismax/status.env on the host and adjust only when
# the local bind address or log filter needs to change.

STATUS_BIND_ADDR=127.0.0.1:8095
STATUS_LOG=status_web=info,tower_http=info

# Optional. When set, the app runs migrations at startup, /readyz checks the
# database, and STATUS_COLLECT_ONCE can persist status snapshots.
# STATUS_DATABASE_URL=postgres://status-dunamismax@localhost/status_dunamismax

# Optional one-shot collector mode for a systemd timer or manual history run.
STATUS_COLLECT_ONCE=false
STATUS_RETENTION_DAYS=30
