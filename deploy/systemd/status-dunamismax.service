[Unit]
Description=Dunamis Status web service
Documentation=https://status.dunamismax.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=status-dunamismax
Group=status-dunamismax
WorkingDirectory=/opt/status-dunamismax
EnvironmentFile=-/etc/status-dunamismax/status.env
ExecStart=/opt/status-dunamismax/status-web
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/status-dunamismax

[Install]
WantedBy=multi-user.target
