[Unit]
Description=Dunamis Status one-shot collector
Documentation=https://status.dunamismax.com/
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=status-dunamismax
Group=status-dunamismax
WorkingDirectory=/opt/status-dunamismax
EnvironmentFile=-/etc/status-dunamismax/status.env
ExecStart=/usr/bin/env STATUS_COLLECT_ONCE=true /opt/status-dunamismax/status-web
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/opt/status-dunamismax
