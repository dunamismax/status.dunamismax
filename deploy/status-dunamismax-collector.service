[Unit]
Description=Dunamis Status TypeScript bounded collector
After=network-online.target postgresql.service
Wants=network-online.target
[Service]
Type=oneshot
User=status-dunamismax
Group=status-dunamismax
WorkingDirectory=/srv/www/status.dunamismax.com/current
EnvironmentFile=/etc/web-apps/status_dunamismax/collector.env
EnvironmentFile=/etc/web-apps/status_dunamismax/collector-settings.env
ExecStart=/opt/node-26/bin/node /srv/www/status.dunamismax.com/current/build/src/collector/cli.js collect
TimeoutStartSec=4min
UMask=0077
StateDirectory=status-dunamismax-collector
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
# Exception to the web-unit sandbox: the collector reads the repository checkouts
# under /home/sawyer/github (STATUS_REPO_ROOT) for its git probes, so home is
# read-only rather than hidden.
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
